-- Lab scenario "gallery": look at particle effects for the portal rims.
--   1. one effect at a time, 4 m in front of the camera, SLOT_MS each; the log gives each one's time since
--      "AUTOTEST armed" (= time in the recording), so a frame at that time shows that effect alone;
--   2. two preview portals (1.2 x 2.0 m ovals) made of RING beads each, blue and orange, side by side.
-- Only names that exist in particles.xr: an unknown name is a FATAL "group" (tools/check_particles.py).

local SLOT_MS = 2200
local SINGLES = {
	"anomaly2\\group_items\\electra_art__idle_glow_01", "anomaly2\\group_items\\bold_art_idle_glow_00",
	"anomaly2\\group_items\\gravi_art__idle_glow_02", "anomaly2\\group_items\\mincer_art__idle_glow_00",
	"anomaly2\\group_items\\art_gravi_vivert_glow_02", "anomaly2\\artefact\\artefact_ameba_glow",
	"anomaly2\\artefact\\artefact_electra_idle_00", "anomaly2\\artefact\\artefact_electra_idle_01",
	"anomaly2\\artefact\\artefact_zharka_idle", "anomaly2\\artefact\\artefact_zharka_idle_00",
	"anomaly2\\artefact\\artefact_gravi_idle_00", "anomaly2\\group_items\\teleport_spark_glow",
	"anomaly2\\group_items\\teleport_glow_idle_vert", "ghoul\\fx-05-blue-glow", "ghoul\\fx-061-blue-glow",
	"ghoul\\fx-10-orang-light", "anomaly2\\group_items\\heat_glow", "explosions\\group_items\\gas_light_glow_00",
	"explosions\\group_items\\campfire_05_glow00", "static\\group_items\\net_base_blue",
}
local RING_BLUE = "anomaly2\\group_items\\electra_art__idle_glow_01"
local RING_ORANGE = "anomaly2\\group_items\\mincer_art__idle_glow_00"
local RING_BEADS = 14

local st = nil
local live = {}

local function go(stage, wait_ms)
	st.stage = stage
	st.t = time_global() + (wait_ms or 0)
end

local function stop_all()
	for _, p in ipairs(live) do
		if p:playing() then
			p:stop()
		end
	end
	live = {}
end

local function play(name, pos)
	local p = particles_object(name)
	p:play_at_pos(pos)
	table.insert(live, p)
	return p
end

-- Camera frame on the ground plane: point d metres ahead at eye level, and the right vector.
local function ahead(d)
	local cam, dir = device().cam_pos, device().cam_dir
	local fwd = vector():set(dir.x, 0, dir.z):normalize()
	return vector():set(cam):add(vector():set(fwd):mul(d)), vector():set(fwd.z, 0, -fwd.x), fwd
end

local function ring(name, center, right, up, w, h)
	for i = 0, RING_BEADS - 1 do
		local a = 2 * math.pi * i / RING_BEADS
		play(name, vector():set(center):add(vector():set(right):mul(w / 2 * math.cos(a))):add(vector():set(up):mul(h / 2 * math.sin(a))))
	end
end

function update()
	if not db.actor then
		return
	end
	if not st then
		st = { armed = time_global(), i = 0 }
		go("move", 4000)
		portal_mod.trace("AUTOTEST armed (gallery)")
		return
	end
	if time_global() < st.t then
		return
	end
	if st.stage == "move" then
		local g = pm_test.open_ground()
		if g then
			db.actor:set_actor_position(g, false)
		end
		portal_mod.news("Галерея эффектов для порталов")
		go("single", 1500)
	elseif st.stage == "single" then
		stop_all()
		st.i = st.i + 1
		local name = SINGLES[st.i]
		if not name then
			go("rings")
			return
		end
		local pos = ahead(4)
		play(name, pos)
		portal_mod.trace(string.format("GALLERY t=%.1f %d %s", (time_global() - st.armed) / 1000, st.i, name))
		go("single", SLOT_MS)
	elseif st.stage == "rings" then
		local c, right = ahead(6)
		local up = vector():set(0, 1, 0)
		ring(RING_BLUE, vector():set(c):add(vector():set(right):mul(-1.2)), right, up, 1.2, 2.0)
		ring(RING_ORANGE, vector():set(c):add(vector():set(right):mul(1.2)), right, up, 1.2, 2.0)
		portal_mod.trace(string.format("GALLERY t=%.1f rings %s / %s", (time_global() - st.armed) / 1000, RING_BLUE, RING_ORANGE))
		portal_mod.news("Пробные порталы из частиц")
		go("end", 6000)
	elseif st.stage == "end" then
		stop_all()
		portal_mod.trace("AUTOTEST RESULT gallery done")
		go("done")
		portal_mod.finish_autotest()
	end
end
